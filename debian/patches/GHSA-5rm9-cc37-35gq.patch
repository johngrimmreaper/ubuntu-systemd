Origin: upstream, https://github.com/systemd/systemd-stable/commit/958aefc3a5b23850b868190dc693e6f735309ecb

(cherry picked from commit 1016dd315f94917cd0818a90bc09c99ef76ab556)
(cherry picked from commit 23bb1e8555fd92162ce10b0b394f79d69f39f404)
(cherry picked from commit 958aefc3a5b23850b868190dc693e6f735309ecb)

(modified for backport to 255.4)
(modified for backport to 249.11)
---
 src/shared/json.c    | 12 ++++++++++++
 src/test/test-json.c | 46 ++++++++++++++++++++++++++++++++++++++++++++++
 2 files changed, 58 insertions(+)

diff --git a/src/shared/json.c b/src/shared/json.c
index d72b1e3..26bc9b1 100644
--- a/src/shared/json.c
+++ b/src/shared/json.c
@@ -2939,6 +2939,12 @@ static int json_parse_internal(
                                 goto finish;
                         }
 
+                        /* n_stack includes the top level entry, hence > instead of >= */
+                        if (n_stack > DEPTH_MAX) {
+                                r = -ELNRNG;
+                                goto finish;
+                        }
+
                         if (!GREEDY_REALLOC(stack, n_stack+1)) {
                                 r = -ENOMEM;
                                 goto finish;
@@ -2990,6 +2996,12 @@ static int json_parse_internal(
                                 goto finish;
                         }
 
+                        /* n_stack includes the top level entry, hence > instead of >= */
+                        if (n_stack > DEPTH_MAX) {
+                                r = -ELNRNG;
+                                goto finish;
